FROM golang:1.25-alpine AS builder

WORKDIR /src

COPY gen/ /gen/

COPY edge/go.mod edge/go.sum ./
RUN go mod download
COPY edge/ .

RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /init ./cmd/init

FROM alpine:3.21
RUN apk add --no-cache iptables
COPY --from=builder /init /init
USER 26248:26248
ENTRYPOINT ["/init"]
