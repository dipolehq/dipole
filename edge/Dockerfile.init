FROM golang:1.25-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
COPY ../gen ../gen
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /init ./cmd/init

FROM alpine:3.21
RUN apk add --no-cache iptables
COPY --from=builder /init /init
USER 26248:26248
ENTRYPOINT ["/init"]
