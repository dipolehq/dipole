FROM golang:1.25-alpine AS builder

WORKDIR /src

COPY gen/ /gen/

COPY edge/go.mod edge/go.sum ./
RUN go mod download
COPY edge/ .

RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /controller ./cmd/controller

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=builder /controller /controller
USER 65534:65534
EXPOSE 80 9090
ENTRYPOINT ["/controller"]
