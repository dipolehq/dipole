FROM golang:1.25-alpine AS builder

WORKDIR /src

# Copy the shared gen module first (replace directive points to ../gen).
COPY gen/ /gen/

# Copy edge module and download dependencies.
COPY edge/go.mod edge/go.sum ./
RUN go mod download
COPY edge/ .

RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /proxy ./cmd/proxy

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=builder /proxy /proxy
USER 65534:65534
EXPOSE 8000 15001 9099
ENTRYPOINT ["/proxy"]
