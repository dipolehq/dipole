FROM golang:1.25-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
COPY ../gen ../gen
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o /extensions/dipole-proxy ./cmd/lambda
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o /extensions/dipole-proxy-bin ./cmd/proxy

FROM scratch
COPY --from=builder /extensions /extensions
